# Abeta KMP Kit — Go 1.26.0 SDUI BFF Environment Example
# Copy to `.env` for local overrides (`.env` is gitignored; never commit secrets).

SERVICE_NAME=abeta-sdui-bff
APP_VERSION=0.9.0
PORT=8080
# HTTP_ADDR=:8080
GIN_MODE=release
TOKEN_CATALOG_VERSION=1.0.0

# CORS (empty by default = fail-closed; comma-separated origins, e.g. https://app.abeta.dev,*.abeta.dev)
CORS_ALLOWED_ORIGINS=

# Trusted reverse proxies (empty by default = trust none; comma-separated IPs/CIDRs, e.g. 10.0.0.0/8,127.0.0.1)
TRUSTED_PROXIES=

# HTTP Server Timeouts (Go time.Duration format; non-negative)
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

# Performance & Caching Middleware
COMPRESSION_ENABLED=true
ETAG_ENABLED=true

# Optional Security Hardening
RATE_LIMIT_ENABLED=false
AUTH_REQUIRED=false
# Required when AUTH_REQUIRED=true (minimum 32 characters; fail-closed)
JWT_SECRET=

# Optional TLS (both must be set together to enable HTTPS + HTTP/2 ALPN, TLS 1.2+)
TLS_CERT_FILE=
TLS_KEY_FILE=
