          "margin": {
            "start": 16,
            "top": 4,
            "end": 16,
            "bottom": 4
          },
          "bg_color": {
            "token": "brand.container"
          },
          "corner_radius": {
            "all": 12
          },
          "border": {
            "width_dp": 1,
            "color": {
              "token": "border.subtle"
            }
          },
          "fill_max_width": true
        }
      }
    },
    {
      "snippet_id": "home_metric_uptime",
