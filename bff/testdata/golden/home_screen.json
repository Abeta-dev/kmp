{
  "page_id": "home",
  "title": "Abeta Workspace",
  "toolbar": {
    "title": {
      "text": "Abeta Workspace",
      "color": {
        "token": "text.primary"
      },
      "typography": {
        "token": "title.large"
      }
    },
    "subtitle": {
      "text": "SDUI Control Center",
      "color": {
        "token": "text.secondary"
      },
      "typography": {
        "token": "body.small"
      }
    },
    "trailing_actions": [
      {
        "name": "refresh",
        "size_dp": 22,
        "color": {
          "token": "text.primary"
        },
        "content_description": "Refresh screen",
        "on_click": {
          "id": "refresh_home",
          "type": "refresh_page",
          "payload": {
            "page_id": "home",
            "show_loader": true
          }
        }
      },
      {
        "name": "info",
        "size_dp": 22,
        "color": {
          "token": "text.secondary"
        },
        "content_description": "About SDUI",
        "on_click": {
          "id": "open_home_info",
          "type": "open_dialog",
          "payload": {
            "dialog_id": "home_info_dialog",
            "title": "Abeta SDUI Engine",
            "message": "Screens are streamed from the Go BFF and rendered natively on KMP.",
            "dismissible": true,
            "positive_action": {
              "id": "dismiss_info",
              "type": "dismiss_overlay",
              "payload": {
                "overlay_id": "home_info_dialog"
              }
            }
          }
        }
      }
    ],
    "bg_color": {
      "token": "surface.primary"
    }
  },
  "snippets": [
    {
      "snippet_id": "home_header",
      "snippet_type": "header_v1",
      "data": {
        "title": {
          "text": "Welcome back, Builder",
          "color": {
            "token": "text.primary"
          },
          "typography": {
            "token": "headline.small"
          }
        },
        "subtitle": {
          "text": "Server-driven UI powered by atomic contracts",
          "color": {
            "token": "text.secondary"
          },
          "typography": {
            "token": "body.medium"
          }
        },
        "leading_icon": {
          "name": "sparkles",
          "size_dp": 24,
          "color": {
            "token": "brand.primary"
          }
        },
        "trailing_tag": {
          "label": "LIVE",
          "bg_color": {
            "token": "status.success_container"
          }
        },
        "trailing_action": {
          "id": "btn_home_catalog",
          "label": "Catalog",
          "variant": "outline",
          "size": "sm",
          "enabled": true,
          "on_click": {
            "id": "nav_catalog",
            "type": "navigate",
            "payload": {
              "route": "/screens/catalog"
            }
          }
        },
        "layout": {
          "padding": {
            "start": 16,
            "top": 12,
            "end": 16,
            "bottom": 12
          },
          "fill_max_width": true
        }
      },
      "tracking": {
        "event_name": "snippet_impression",
        "properties": {
          "snippet_id": "home_header"
        }
      }
    },
    {
      "snippet_id": "home_promo_banner",
      "snippet_type": "banner_v1",
      "data": {
        "title": {
          "text": "Zero-Release UI Updates",
          "color": {
            "token": "text.primary"
          },
          "typography": {
            "token": "title.medium"
          }
        },
        "body": {
          "text": "Ship layout, theming, and action workflows instantly across Android, iOS, and Desktop.",
