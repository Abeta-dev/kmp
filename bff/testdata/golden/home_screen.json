  "bottom_bar": {
    "primary_button": {
      "id": "btn_bottom_refresh",
      "label": "Refresh Dashboard",
      "variant": "primary",
      "enabled": true,
      "on_click": {
        "id": "batch_refresh_home",
        "type": "batch",
        "payload": {
          "actions": [
            {
              "id": "track_home_refresh",
              "type": "track_event",
              "payload": {
                "event_name": "home_refresh_clicked",
                "properties": {
                  "source": "bottom_bar"
                }
              }
            },
            {
              "id": "refresh_home",
              "type": "refresh_page",
              "payload": {
                "page_id": "home",
                "show_loader": true
              }
            }
          ],
          "stop_on_error": true
        }
      }
    },
    "helper_text": {
      "text": "Synced via Abeta BFF",
      "color": {
        "token": "text.tertiary"
      },
      "typography": {
        "token": "caption"
      }
    },
    "layout": {
      "padding": {
        "start": 12,
        "top": 12,
        "end": 12,
        "bottom": 12
      },
      "bg_color": {
        "token": "surface.primary"
      },
      "fill_max_width": true
    }
  },
  "page_actions": [
    {
      "id": "track_home_view",
      "type": "track_event",
      "payload": {
        "event_name": "screen_viewed",
        "properties": {
          "screen_id": "home"
        }
      }
    }
  ],
  "tracking": {
    "event_name": "page_loaded",
    "properties": {
      "page_id": "home"
    }
  }
}
