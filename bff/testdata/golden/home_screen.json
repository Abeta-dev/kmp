          "padding": {
            "start": 16,
            "top": 16,
            "end": 16,
            "bottom": 16
          },
          "margin": {
            "start": 16,
            "top": 4,
            "end": 16,
            "bottom": 4
          },
          "bg_color": {
            "token": "surface.primary"
          },
          "corner_radius": {
            "all": 12
          },
          "border": {
            "width_dp": 1,
            "color": {
              "token": "border.subtle"
            }
          },
          "fill_max_width": true
        }
      }
    },
    {
      "snippet_id": "home_div_1",
      "snippet_type": "divider",
      "data": {
        "divider": {
          "thickness_dp": 1,
          "color": {
