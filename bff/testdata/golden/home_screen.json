            "token": "text.secondary"
          },
          "typography": {
            "token": "body.small"
          }
        },
        "icon": {
          "name": "rocket",
          "size_dp": 24,
          "color": {
            "token": "brand.primary"
          }
        },
        "tag": {
          "label": "v1.0",
          "bg_color": {
            "token": "surface.primary"
          }
        },
        "cta": {
          "id": "btn_open_form",
